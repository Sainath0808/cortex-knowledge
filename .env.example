# ---- App ----
ENVIRONMENT=local
DEBUG=true
JWT_SECRET_KEY=change-me-to-a-long-random-string

# ---- Data stores ----
DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5433/cortex
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
MCP_OWNER_ID=
EVAL_OWNER_ID=

# ---- LLM provider ----
# "azure" uses the AZURE_OPENAI_* settings below.
# "openai" works with any OpenAI-compatible endpoint: OpenAI itself, an LLM
# gateway (LiteLLM/Portkey), OpenRouter, Groq, or local Ollama.
# NOTE: changing the EMBEDDING model invalidates existing Qdrant vectors -
# re-ingest documents after switching, and keep EMBEDDING_DIMENSIONS in sync.
LLM_PROVIDER=azure
#LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama
#LLM_API_KEY=sk-...                        # or gateway virtual key ("ollama" for Ollama)
#LLM_CHAT_MODEL=gpt-4o
#LLM_EMBEDDING_MODEL=text-embedding-3-large

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
LLM_TEMPERATURE=0.1
LLM_MAX_COMPLETION_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- Ingestion / chunking ----
# Options: fixed, recursive, semantic, structure_aware
CHUNKING_STRATEGY=recursive
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RAG_QUERY_REWRITING=true

# ---- Observability ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---- Rate limiting ----
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
